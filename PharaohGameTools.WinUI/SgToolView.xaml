<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PharaohGameTools.WinUI.SgToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{ThemeResource AppHeaderSpacing}">
            <TextBlock
                Text="SG3 Tool"
                FontSize="{ThemeResource AppFontSizeTitle}"
                FontWeight="SemiBold" />
            <TextBlock
                Text="Browse SG3 archives, inspect image records, preview sprites, animate matching sequences, replace images, and save rebuilt SG3 data."
                TextWrapping="Wrap"
                Opacity="0.82" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="{ThemeResource AppSectionMargin}"
            Padding="{ThemeResource AppCardPadding}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCardCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="{ThemeResource AppSectionSpacing}">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource AppControlSpacing}">
                            <Button
                                x:Name="OpenButton"
                                Content="Open SG3..."
                                Click="OpenButton_Click" />
                            <Button
                                x:Name="SaveButton"
                                Content="Save File..."
                                IsEnabled="False"
                                Click="SaveButton_Click" />
                            <Button
                                x:Name="SaveAllButton"
                                Content="Save All..."
                                IsEnabled="False"
                                Click="SaveAllButton_Click" />
                            <Button
                                x:Name="BatchExportButton"
                                Content="Batch Export..."
                                Click="BatchExportButton_Click" />
                            <Button
                                x:Name="BatchImportButton"
                                Content="Batch Import..."
                                Click="BatchImportButton_Click" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource AppControlSpacing}">
                            <CheckBox
                                x:Name="HideSystemItemsCheckBox"
                                VerticalAlignment="Center"
                                Content="Hide system items"
                                Checked="HideSystemItemsCheckBox_Changed"
                                Unchecked="HideSystemItemsCheckBox_Changed" />
                            <CheckBox
                                x:Name="AnimatePreviewCheckBox"
                                VerticalAlignment="Center"
                                Content="Animate sequence"
                                Checked="AnimatePreviewCheckBox_Changed"
                                Unchecked="AnimatePreviewCheckBox_Changed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Ready"
                    Message="Open one or more SG3 files to inspect packages and images.">
                </InfoBar>
            </StackPanel>
        </Border>

        <Grid
            x:Name="PanelsGrid"
            Grid.Row="2"
            ColumnSpacing="0"
            SizeChanged="PanelsGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="1.1*" MinWidth="{ThemeResource AppArchivePaneMinWidth}" />
                <ColumnDefinition Width="{ThemeResource AppPanelSplitterSize}" />
                <ColumnDefinition x:Name="MiddlePaneColumn" Width="1.9*" MinWidth="{ThemeResource AppImagesPaneMinWidth}" />
                <ColumnDefinition Width="{ThemeResource AppPanelSplitterSize}" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="1.25*" MinWidth="{ThemeResource AppPreviewPaneMinWidth}" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppCardCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="{ThemeResource AppCardHeaderPadding}"
                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ArchiveDisplayNameSortButton"
                            Grid.Column="0"
                            Text="Available Files"
                            Tag="Archive:DisplayName"
                            FontWeight="SemiBold"
                            Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock
                            x:Name="ArchiveTypeSortButton"
                            Grid.Column="1"
                            Text="Type"
                            Tag="Archive:Type"
                            FontWeight="SemiBold"
                            Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock
                            x:Name="ArchiveStateSortButton"
                            Grid.Column="2"
                            Text="State"
                            Tag="Archive:State"
                            FontWeight="SemiBold"
                            Tapped="SortHeaderTextBlock_Tapped" />
                    </Grid>

                    <ListView
                        x:Name="ArchivesListView"
                        Grid.Row="1"
                        Style="{ThemeResource CompactDataListViewStyle}"
                        SelectionChanged="ArchivesListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{ThemeResource AppListRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TypeText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <primitives:Thumb
                x:Name="LeftPaneThumb"
                Grid.Column="1"
                Width="{ThemeResource AppPanelSplitterSize}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerEntered="ResizeThumb_PointerEntered"
                PointerExited="ResizeThumb_PointerExited"
                DragDelta="LeftPaneThumb_DragDelta"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Border
                Grid.Column="2"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppCardCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="{ThemeResource AppCardHeaderPadding}"
                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ImageIdSortButton" Grid.Column="0" Text="ID" Tag="Image:Id" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageNameSortButton" Grid.Column="1" Text="Name" Tag="Image:Name" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageGroupSortButton" Grid.Column="2" Text="Group" Tag="Image:Group" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageSubgroupSortButton" Grid.Column="3" Text="Subgroup" Tag="Image:Subgroup" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageTypeSortButton" Grid.Column="4" Text="Type" Tag="Image:Type" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageSizeSortButton" Grid.Column="5" Text="Size" Tag="Image:Size" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageSourceSortButton" Grid.Column="6" Text="Source" Tag="Image:Source" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                        <TextBlock x:Name="ImageMirrorSortButton" Grid.Column="7" Text="Mirror" Tag="Image:Mirror" FontWeight="SemiBold" Tapped="SortHeaderTextBlock_Tapped" />
                    </Grid>

                    <ListView
                        x:Name="ImagesListView"
                        Grid.Row="1"
                        Style="{ThemeResource CompactDataListViewStyle}"
                        SelectionMode="Single"
                        SingleSelectionFollowsFocus="False"
                        IsSwipeEnabled="False"
                        CanDragItems="False"
                        CanReorderItems="False"
                        SelectionChanged="ImagesListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{ThemeResource AppListRowPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DisplayIdText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding SubgroupName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding TypeText}" />
                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Source555Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding MirrorText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <primitives:Thumb
                x:Name="RightPaneThumb"
                Grid.Column="3"
                Width="{ThemeResource AppPanelSplitterSize}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerEntered="ResizeThumb_PointerEntered"
                PointerExited="ResizeThumb_PointerExited"
                DragDelta="RightPaneThumb_DragDelta"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Border
                Grid.Column="4"
                Padding="{ThemeResource AppCardPadding}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppCardCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid x:Name="PreviewDetailsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="PreviewPaneRow" Height="1.6*" MinHeight="{ThemeResource AppPreviewPaneMinHeight}" />
                        <RowDefinition Height="{ThemeResource AppPanelSplitterSize}" />
                        <RowDefinition x:Name="DetailsPaneRow" Height="0.9*" MinHeight="{ThemeResource AppDetailsPaneMinHeight}" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="PackageInfoTextBlock"
                        Text="Package:"
                        FontWeight="SemiBold" />

                    <Border
                        Grid.Row="1"
                        Margin="{ThemeResource AppPreviewMargin}"
                        Padding="{ThemeResource AppCardPadding}"
                        CornerRadius="{ThemeResource AppCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <Grid>
                            <Viewbox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <Image
                                    x:Name="PreviewImage"
                                    Stretch="None" />
                            </Viewbox>
                            <TextBlock
                                x:Name="OverlayTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="Select an image to preview"
                                Opacity="0.75" />
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Row="2"
                        Height="{StaticResource AppPanelSplitterSize}"
                        Background="Transparent">
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Height="2"
                            CornerRadius="1"
                            Background="{ThemeResource ShellOutlineBrush}"
                            Opacity="0.9" />
                        <primitives:Thumb
                            x:Name="PreviewDetailsThumb"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            PointerEntered="ResizeThumb_PointerEntered"
                            PointerExited="ResizeThumb_PointerExited"
                            DragDelta="PreviewDetailsThumb_DragDelta"
                            Background="Transparent" />
                    </Grid>

                    <Grid
                        Grid.Row="3"
                        RowSpacing="{ThemeResource AppControlSpacing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="{ThemeResource AppDetailsBodyMinHeight}" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource AppControlSpacing}"
                            Margin="{ThemeResource AppSectionMargin}">
                            <Button
                                x:Name="SaveImageButton"
                                Content="Save Image..."
                                IsEnabled="False"
                                Click="SaveImageButton_Click" />
                            <Button
                                x:Name="ReplaceImageButton"
                                Content="Replace Image..."
                                IsEnabled="False"
                                Click="ReplaceImageButton_Click" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <TextBlock
                                x:Name="InfoTextBlock"
                                Text="Select a package and an image."
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

