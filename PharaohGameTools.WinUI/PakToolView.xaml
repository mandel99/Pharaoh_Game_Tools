<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PharaohGameTools.WinUI.PakToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{ThemeResource AppHeaderSpacing}">
            <TextBlock
                Text="PAK Tool"
                Style="{ThemeResource CompactSectionTitleTextStyle}" />
            <TextBlock
                Text="Open Pharaoh mission PAK archives, inspect SAV entries, replace data, and rebuild the archive."
                TextWrapping="Wrap"
                Opacity="0.82" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="{ThemeResource AppSectionMargin}"
            Padding="{ThemeResource AppCardPadding}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCardCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="{ThemeResource AppSectionSpacing}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{ThemeResource AppControlSpacing}">
                    <Button
                        x:Name="OpenButton"
                        Content="Open PAK..."
                        Click="OpenButton_Click" />
                    <Button
                        x:Name="SaveButton"
                        Content="Save PAK..."
                        IsEnabled="False"
                        Click="SaveButton_Click" />
                    <Button
                        x:Name="ExtractButton"
                        Content="Extract Entry..."
                        IsEnabled="False"
                        Click="ExtractButton_Click" />
                    <Button
                        x:Name="ReplaceButton"
                        Content="Replace Entry..."
                        IsEnabled="False"
                        Click="ReplaceButton_Click" />
                    <Button
                        x:Name="BatchExportButton"
                        Content="Batch Export..."
                        IsEnabled="False"
                        Click="BatchExportButton_Click" />
                    <Button
                        x:Name="BatchImportButton"
                        Content="Batch Import..."
                        IsEnabled="False"
                        Click="BatchImportButton_Click" />
                </StackPanel>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Ready"
                    Message="Open a PAK file to inspect its entries." />

                <TextBlock
                    x:Name="SelectionInfoTextBlock"
                    Text="Open a PAK file."
                    TextWrapping="Wrap"
                    Opacity="0.9" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCardCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="{ThemeResource AppCardHeaderPadding}"
                    Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Mission" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="File" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Version" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Offset" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Size" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7" Text="State" FontWeight="SemiBold" />
                </Grid>

                <ListView
                    x:Name="EntriesListView"
                    Grid.Row="1"
                    Style="{ThemeResource CompactDataListViewStyle}"
                    SelectionChanged="EntriesListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="{ThemeResource AppListRowPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding IdText}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding MissionDisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding FileDisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding FileVersionText}" />
                                <TextBlock Grid.Column="5" Text="{Binding OffsetText}" FontFamily="Consolas" />
                                <TextBlock Grid.Column="6" Text="{Binding SizeText}" />
                                <TextBlock Grid.Column="7" Text="{Binding StateText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

