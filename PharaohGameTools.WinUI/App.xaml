<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PharaohGameTools.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PharaohGameTools.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="AppFontSizeBody">15</x:Double>
            <x:Double x:Key="AppFontSizeSmall">14</x:Double>
            <x:Double x:Key="AppFontSizeTitle">16</x:Double>
            <StaticResource x:Key="InfoBarTitleFontSize" ResourceKey="AppFontSizeSmall" />
            <StaticResource x:Key="InfoBarMessageFontSize" ResourceKey="AppFontSizeSmall" />
            <x:Double x:Key="AppHeaderSpacing">4</x:Double>
            <x:Double x:Key="AppPageSpacing">24</x:Double>
            <x:Double x:Key="AppSectionSpacing">6</x:Double>
            <x:Double x:Key="AppControlSpacing">4</x:Double>
            <x:Double x:Key="AppMenuMinHeight">30</x:Double>
            <x:Double x:Key="AppPanelSplitterSize">6</x:Double>
            <x:Double x:Key="AppPreviewMaxOverlayWidth">460</x:Double>
            <x:Double x:Key="AppBikPreviewMinHeight">300</x:Double>
            <x:Double x:Key="AppButtonMinWidthWide">90</x:Double>
            <x:Double x:Key="AppButtonMinWidthMedium">80</x:Double>
            <x:Double x:Key="AppTabMaxWidth">140</x:Double>
            <x:Double x:Key="AppSortHeaderPaddingHorizontal">0</x:Double>
            <x:Double x:Key="AppSortHeaderPaddingVertical">0</x:Double>
            <x:Double x:Key="AppArchivePaneMinWidth">180</x:Double>
            <x:Double x:Key="AppImagesPaneMinWidth">280</x:Double>
            <x:Double x:Key="AppPreviewPaneMinWidth">220</x:Double>
            <x:Double x:Key="AppPreviewPaneMinHeight">120</x:Double>
            <x:Double x:Key="AppDetailsPaneMinHeight">72</x:Double>
            <x:Double x:Key="AppDetailsBodyMinHeight">48</x:Double>
            <Thickness x:Key="AppSectionMargin">0,8,0,8</Thickness>
            <Thickness x:Key="AppPagePadding">24,16,24,16</Thickness>
            <Thickness x:Key="AppCardPadding">8</Thickness>
            <Thickness x:Key="AppCardHeaderPadding">8,6,8,6</Thickness>
            <Thickness x:Key="AppListRowPadding">4,2,4,2</Thickness>
            <Thickness x:Key="AppTabContentPadding">8,4,8,8</Thickness>
            <Thickness x:Key="AppTabHeaderPadding">12,6,12,6</Thickness>
            <Thickness x:Key="AppWindowDragBarMargin">6,4,6,0</Thickness>
            <Thickness x:Key="AppShellMargin">6,4,6,6</Thickness>
            <Thickness x:Key="AppTabItemMargin">3,0,3,0</Thickness>
            <Thickness x:Key="AppMenuItemMargin">1,1,1,1</Thickness>
            <Thickness x:Key="AppIconMargin">0,0,6,0</Thickness>
            <Thickness x:Key="AppZeroThickness">0</Thickness>
            <Thickness x:Key="AppPreviewMargin">0,6,0,6</Thickness>
            <Thickness x:Key="AppHeaderButtonPadding">0</Thickness>
            <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppShellCornerRadius">10</CornerRadius>

            <Style x:Key="CompactSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeTitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="FlatSortHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="{StaticResource AppHeaderButtonPadding}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="{StaticResource AppZeroThickness}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CompactDataListViewStyle" TargetType="ListView">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeSmall}" />
                <Setter Property="Padding" Value="{StaticResource AppZeroThickness}" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
                <Setter Property="MinHeight" Value="30" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="MenuBar">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="InfoBar">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeSmall}" />
                <Setter Property="Padding" Value="8,4,8,4" />
            </Style>
            <SolidColorBrush x:Key="ActiveTabSurfaceBrush" Color="#FF202731" />
            <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FF202731" />
            <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#FF202731" />
            <SolidColorBrush x:Key="ShellSurfaceAltBrush" Color="#FF262E38" />
            <SolidColorBrush x:Key="ShellOutlineBrush" Color="#667C8EA3" />
            <SolidColorBrush x:Key="TabViewBackground" Color="#FF202731" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#FF222931" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="ActiveTabSurfaceBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" ResourceKey="ActiveTabSurfaceBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelectedPressed" ResourceKey="ActiveTabSurfaceBrush" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#FF2A323B" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#FF323B46" />
            <SolidColorBrush x:Key="TabViewItemHeaderBorderBrush" Color="#557C8EA3" />
            <SolidColorBrush x:Key="TabViewItemHeaderBorderBrushSelected" Color="#667C8EA3" />
            <SolidColorBrush x:Key="TabViewItemHeaderBorderBrushSelectedPointerOver" Color="#667C8EA3" />
            <SolidColorBrush x:Key="TabViewItemHeaderBorderBrushSelectedPressed" Color="#667C8EA3" />
            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#F2F6FA" />
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

