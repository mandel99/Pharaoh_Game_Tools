<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PharaohGameTools.WinUI.TextToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{ThemeResource AppHeaderSpacing}">
            <TextBlock
                Text="Text Tool"
                Style="{ThemeResource CompactSectionTitleTextStyle}" />
            <TextBlock
                Text="Open, inspect, edit, and save Pharaoh TXT / ENG resources directly in the WinUI version."
                Opacity="0.8"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="{ThemeResource AppSectionMargin}"
            Padding="{ThemeResource AppCardPadding}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCardCornerRadius}">
            <StackPanel Spacing="{ThemeResource AppSectionSpacing}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{ThemeResource AppControlSpacing}">
                        <Button
                            x:Name="OpenButton"
                            Content="Open TXT / ENG..."
                            Click="OpenButton_Click" />
                        <Button
                            x:Name="SaveTxtButton"
                            Content="Save TXT..."
                            IsEnabled="False"
                            Click="SaveTxtButton_Click" />
                        <Button
                            x:Name="SaveEngButton"
                            Content="Save ENG..."
                            IsEnabled="False"
                            Click="SaveEngButton_Click" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="{ThemeResource AppControlSpacing}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Encoding"
                            FontWeight="SemiBold" />
                        <ComboBox
                            x:Name="EncodingComboBox"
                            Width="280"
                            SelectedIndex="0"
                            SelectionChanged="EncodingComboBox_SelectionChanged">
                            <x:String>Auto (Windows-1252)</x:String>
                            <x:String>Windows-1252 - Default</x:String>
                            <x:String>Windows-1250 - Eastern European</x:String>
                            <x:String>Windows-1251 - Cyrillic</x:String>
                            <x:String>Windows-1253 - Greek</x:String>
                            <x:String>Windows-949 - Korean</x:String>
                            <x:String>Windows-932 - Japanese</x:String>
                            <x:String>Traditional Chinese (C3)</x:String>
                            <x:String>Simplified Chinese (C3)</x:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Ready"
                    Message="Open a TXT or ENG file to start editing." />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AppCardCornerRadius}">
            <TextBox
                x:Name="EditorTextBox"
                AcceptsReturn="True"
                IsEnabled="False"
                IsSpellCheckEnabled="False"
                TextWrapping="Wrap"
                TextChanged="EditorTextBox_TextChanged"
                Background="Transparent"
                BorderThickness="0"
                Padding="{ThemeResource AppCardPadding}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>

